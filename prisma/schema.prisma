// Aqim — Prisma schema (PostgreSQL)
// Quranic text and tafsir are seeded once from a trusted source (Tanzil via
// api.alquran.cloud) and stored locally. They are NEVER generated at runtime.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Reference data (read-only after seeding, sourced from Tanzil / al-Quran Cloud)
// ---------------------------------------------------------------------------

model Surah {
  number         Int     @id // 1..114
  nameArabic     String
  nameEnglish    String
  nameTranslit   String
  revelationType String // "Meccan" | "Medinan"
  ayahCount      Int

  ayahs        QuranText[]
  tafsir       TafsirText[]
  translations TranslationText[]

  @@map("surah")
}

model QuranText {
  id         Int    @id @default(autoincrement())
  surahNumber Int   @map("surah_number")
  ayahNumber  Int   @map("ayah_number")
  arabicText  String @map("arabic_text")
  juzNumber   Int   @map("juz_number")
  pageNumber  Int   @map("page_number")

  surah Surah @relation(fields: [surahNumber], references: [number])

  @@unique([surahNumber, ayahNumber])
  @@index([juzNumber])
  @@map("quran_text")
}

model TafsirText {
  id          Int    @id @default(autoincrement())
  surahNumber Int    @map("surah_number")
  ayahNumber  Int    @map("ayah_number")
  tafsirSource String @map("tafsir_source") // e.g. "Tafsir al-Muyassar (King Fahd Complex)"
  sourceUrl    String? @map("source_url")   // link to open the full tafsir
  summaryText  String @map("summary_text")  // condensed 2-3 lines (from existing tafsir)
  fullText     String @map("full_text")     // original tafsir text, unmodified

  surah Surah @relation(fields: [surahNumber], references: [number])

  @@unique([surahNumber, ayahNumber, tafsirSource])
  @@map("tafsir_text")
}

// Small key/value store — used to track the seed version so the seed can
// re-run (and regenerate derived data like tafsir summaries) when its logic
// changes, even though the row counts are unchanged.
model Meta {
  key   String @id
  value String

  @@map("meta")
}

// Hisn al-Muslim adhkar — verified once against independent copies and stored
// locally (same accuracy principle as the Quran text; never AI-generated).
model AdhkarText {
  id           Int     @id @default(autoincrement())
  chapterIndex Int     @map("chapter_index") // book order
  chapter      String // chapter title (Arabic, as printed)
  position     Int // order within the chapter
  text         String
  count        Int     @default(1) // prescribed repetitions
  reference    String?
  source       String // citation label

  @@index([chapterIndex])
  @@map("adhkar_text")
}

// Sahih al-Bukhari & Sahih Muslim — verified once against an independent
// second dataset and stored locally (same accuracy principle as the Quran
// text; never AI-generated or paraphrased).
model HadithText {
  id         Int    @id @default(autoincrement())
  collection String // "bukhari" | "muslim"
  number     Int // hadith number within the collection
  book       Int? // book (kitab) number
  text       String // Arabic text, verbatim from the verified dataset
  source     String // citation label

  @@unique([collection, number])
  @@map("hadith_text")
}

// Timestamped totals of memorized ayat — one row whenever the total changes —
// for the growth-over-time chart.
model MemoSnapshot {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  totalAyat Int      @map("total_ayat")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("memo_snapshot")
}

model TranslationText {
  id          Int    @id @default(autoincrement())
  surahNumber Int    @map("surah_number")
  ayahNumber  Int    @map("ayah_number")
  source      String // e.g. "Saheeh International (en.sahih)"
  text        String

  surah Surah @relation(fields: [surahNumber], references: [number])

  @@unique([surahNumber, ayahNumber, source])
  @@map("translation_text")
}

// ---------------------------------------------------------------------------
// User data
// ---------------------------------------------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  // Anonymous per-device identity (from the aqim-uid cookie).
  uid       String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  // Optional account identity — lets the same history follow the user
  // across devices. Password accounts store a bcrypt hash; Google accounts
  // store the Google subject id.
  email        String? @unique
  passwordHash String? @map("password_hash")
  googleSub    String? @unique @map("google_sub")
  // Hourglass streak: reading extends the clock; expiry resets the count.
  streakCount     Int       @default(0) @map("streak_count")
  streakExpiresAt DateTime? @map("streak_expires_at")
  streakLastDay   String?   @map("streak_last_day")

  memorization      Memorization[]
  recitationHistory RecitationHistory[]
  settings          Settings?
  sessions          AuthSession[]
  state             UserState?
  resetTokens       PasswordResetToken[]

  @@map("users")
}

// One JSON blob of the client's on-device state (wird, tasbih, focus,
// completions) — the durable copy that survives reinstalls and follows
// the account across devices. Last-writer-wins by the client timestamp.
model UserState {
  userId    Int      @id @map("user_id")
  data      String   @default("{}")
  ts        BigInt   @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_state")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// Web-push subscriptions + the minimal prefs needed to compute reminder
// times on the server (times are computed from coordinates; nothing else).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  lang      String   @default("ar")
  lat       Float?
  lng       Float?
  method    String   @default("umm_alqura")
  prayers   Boolean  @default(false) // prayer-time reminders
  wirdTime  String?  @map("wird_time") // "HH:MM" local, null = off
  adhkar    Boolean  @default(false) // morning/evening adhkar nudges
  tzOffset  Int      @default(0) @map("tz_offset") // minutes east of UTC
  userId    Int?     @map("user_id") // links reminders to the user's streak
  lastSent  String   @default("{}") @map("last_sent") // JSON dedupe map
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("push_subscriptions")
}

model Memorization {
  id          Int @id @default(autoincrement())
  userId      Int @map("user_id")
  surahNumber Int @map("surah_number")
  fromAyah    Int @map("from_ayah")
  toAyah      Int @map("to_ayah")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("memorization")
}

model RecitationHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  prayerType  String   @map("prayer_type") // fajr | dhuhr | asr | maghrib | isha | witr | qiyam | nafl
  mode        String // faraid | nafl | qiyam
  rakahNumber Int      @map("rakah_number")
  surahNumber Int      @map("surah_number")
  fromAyah    Int      @map("from_ayah")
  toAyah      Int      @map("to_ayah")
  usedAt      DateTime @default(now()) @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("recitation_history")
}

model Settings {
  userId          Int     @id @map("user_id")
  witrRakahs      Int     @default(1) @map("witr_rakahs")
  noRepeatWindow  Int     @default(5) @map("no_repeat_window") // prayers
  qiyamRepeatWindow Int   @default(7) @map("qiyam_repeat_window") // sessions
  tafsirSource    String  @default("ar.muyassar") @map("tafsir_source")
  font            String  @default("amiri-quran")
  maxAyahShort    Int     @default(10) @map("max_ayah_short") // "short/medium" surah threshold for faraid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}
